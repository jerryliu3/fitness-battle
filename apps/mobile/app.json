{
  "expo": {
    "name": "Fitness Battle",
    "slug": "fitness-battle",
    "scheme": "fitnessbattle",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#eef1f4"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "react-native-health",
      "react-native-health-connect"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.fitnessbattle.app",
      "infoPlist": {
        "NSHealthShareUsageDescription": "Fitness Battle reads workouts so your week can be scored.",
        "NSHealthUpdateUsageDescription": "Fitness Battle does not write health data.",
        "CFBundleURLTypes": [
          {
            "CFBundleURLSchemes": ["fitnessbattle"]
          }
        ]
      }
    },
    "android": {
      "package": "com.fitnessbattle.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#12141a"
      },
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": false,
          "data": [
            {
              "scheme": "fitnessbattle"
            }
          ],
          "category": ["BROWSABLE", "DEFAULT"]
        }
      ],
      "permissions": [
        "android.permission.health.READ_EXERCISE",
        "android.permission.health.READ_HEART_RATE",
        "android.permission.health.READ_SLEEP"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "eas": {
        "projectId": "fitness-battle-placeholder"
      }
    },
    "owner": "fitness-battle"
  }
}
