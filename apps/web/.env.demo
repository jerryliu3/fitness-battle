# Copy to apps/web/.env.local when you only need localhost UI (e.g. /ux/vitals-body).
# No Docker, no remote Supabase — sign in with any demo email + password (4+ chars).
#
#   cp apps/web/.env.demo apps/web/.env.local
#   pnpm dev
#   alice@example.com / demo
#
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54621
NEXT_PUBLIC_SUPABASE_ANON_KEY=public-anon-key
NEXT_PUBLIC_USE_DEMO_DATA=true
NEXT_PUBLIC_APP_URL=http://localhost:3000
