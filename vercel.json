{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "installCommand": "pnpm install",
  "buildCommand": "pnpm --filter @fitness-battle/web build",
  "ignoreCommand": "if [ \"$VERCEL_ENV\" == \"production\" ]; then exit 1; else exit 0; fi",
  "git": {
    "deploymentEnabled": {
      "main": true,
      "*": false,
      "**/*": false,
      "**": false
    }
  },
  "crons": [
    {
      "path": "/api/fitness/garmin/retry",
      "schedule": "0 8 * * *"
    }
  ]
}
