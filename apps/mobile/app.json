{
  "expo": {
    "name": "Fitness Battle",
    "slug": "fitness-battle",
    "scheme": "fitnessbattle",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "plugins": ["expo-router", "expo-font"],
    "experiments": {
      "typedRoutes": true
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.fitnessbattle.app"
    },
    "android": {
      "package": "com.fitnessbattle.app"
    },
    "web": {
      "bundler": "metro",
      "output": "static"
    }
  }
}
