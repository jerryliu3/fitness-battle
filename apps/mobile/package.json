    "@expo-google-fonts/nunito-sans": "^0.4.2",
    "@expo/metro-runtime": "~6.1.2",
    "@fitness-battle/pursuit": "workspace:*",
    "@fitness-battle/shared": "workspace:*",
    "@gorhom/bottom-sheet": "^5.2.9",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@supabase/supabase-js": "^2.106.2",
    "babel-preset-expo": "~54.0.12",
    "expo": "^54.0.37",
    "expo-constants": "~18.0.14",
    "expo-device": "~8.0.10",
    "expo-document-picker": "~14.0.8",
    "expo-font": "~14.0.12",
    "expo-image-picker": "~17.0.11",
    "expo-linking": "^8.0.7",
    "expo-notifications": "~0.32.17",
    "expo-router": "^6.0.8",
    "expo-status-bar": "^3.0.8",
    "expo-web-browser": "~15.0.11",
    "heroui-native": "^1.0.10",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-health": "^1.19.0",
    "react-native-health-connect": "^4.1.3",
    "react-native-reanimated": "~4.1.1",
    "react-native-safe-area-context": "~5.6.1",
    "react-native-screens": "~4.16.0",
    "react-native-svg": "15.12.1",
