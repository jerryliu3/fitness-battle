{
  "expo": {
    "name": "Overtaek",
    "slug": "overtaek",
    "scheme": "overtaek",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-notifications",
        {
          "color": "#B7F255",
          "defaultChannel": "default",
          "sounds": []
        }
      ],
      [
        "react-native-health",
        {
          "isClinicalDataEnabled": false,
          "healthSharePermission": "Overtaek reads workouts so your week can be scored.",
          "healthUpdatePermission": "Overtaek does not write health data."
        }
      ],
      "react-native-health-connect",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.overtaek.app",
      "infoPlist": {
        "CFBundleDisplayName": "Overtaek",
        "NSHealthShareUsageDescription": "Overtaek reads workouts so your week can be scored.",
        "NSHealthUpdateUsageDescription": "Overtaek does not write health data.",
        "ITSAppUsesNonExemptEncryption": false,
        "CFBundleURLTypes": [
          {
            "CFBundleURLSchemes": [
              "overtaek"
            ]
          }
        ]
      }
    },
    "android": {
      "package": "com.overtaek.app",
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": false,
          "data": [
            {
              "scheme": "overtaek"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ],
      "permissions": [
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.health.READ_EXERCISE",
        "android.permission.health.READ_HEART_RATE",
        "android.permission.health.READ_SLEEP"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static"
    },
    "extra": {
      "eas": {
        "projectId": "30807072-a0b4-44cd-bd15-ec186e40ceed"
      },
      "supportEmail": "jerrry333x@gmail.com"
    }
  }
}
