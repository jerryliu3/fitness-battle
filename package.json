{
  "name": "fitness-battle",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@9.15.4",
  "scripts": {
    "dev": "pnpm --filter @fitness-battle/web dev",
    "dev:mobile": "pnpm --filter @fitness-battle/mobile dev",
    "dev:web": "pnpm --filter @fitness-battle/web dev",
    "build": "pnpm --filter @fitness-battle/web build",
    "build:web": "pnpm --filter @fitness-battle/web build",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r lint",
    "test": "pnpm -r test",
    "supabase:start": "supabase start",
    "supabase:stop": "supabase stop",
    "supabase:status": "supabase status",
    "supabase:reset": "supabase db reset",
    "rankings:db:start": "supabase start --workdir rankings-db",
    "rankings:db:reset": "supabase db reset --workdir rankings-db",
    "rankings:ingest": "node packages/rankings/scripts/ingest.mjs",
    "ow:clone": "bash scripts/open-wearables.sh clone",
    "ow:up": "bash scripts/open-wearables.sh up",
    "ow:down": "bash scripts/open-wearables.sh down",
    "ow:status": "bash scripts/open-wearables.sh status"
  },
  "devDependencies": {
    "typescript": "^5.9.2"
  }
}
