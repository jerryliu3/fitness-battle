    "expo-web-browser": "~57.0.3",
    "heroui-native": "^1.0.10",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-health": "^1.19.0",
    "react-native-health-connect": "^4.1.3",
    "react-native-reanimated": "~4.5.1",
