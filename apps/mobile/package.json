{
  "name": "@fitness-battle/mobile",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "dev": "expo start --clear",
    "web": "expo start --web --clear",
    "study": "OVERTAEK_STUDY_PREVIEW=1 expo start --web --localhost --port 8081",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "typecheck": "tsc --noEmit",
    "lint": "echo 'no lint configured'",
    "test": "vitest run",
    "eas:build:ios": "npx eas-cli@latest build --platform ios --profile production",
    "eas:submit:ios": "npx eas-cli@latest submit --platform ios --profile production --latest"
  },
  "dependencies": {
    "@babel/runtime": "^7.29.10",
    "@expo-google-fonts/bebas-neue": "^0.4.0",
    "@expo-google-fonts/dm-sans": "^0.4.0",
    "@expo-google-fonts/manrope": "^0.4.0",
    "@expo-google-fonts/nunito-sans": "^0.4.2",
    "@expo/dom-webview": "~58.0.2",
    "@expo/metro-runtime": "~58.0.15",
    "@fitness-battle/pursuit": "workspace:*",
    "@fitness-battle/shared": "workspace:*",
    "@gorhom/bottom-sheet": "^5.2.9",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/datetimepicker": "9.2.1",
    "@react-native-picker/picker": "2.11.4",
    "@supabase/supabase-js": "^2.106.2",
    "@tabler/icons-react-native": "^3.49.0",
    "babel-preset-expo": "~58.0.19",
    "expo": "^58.0.17",
    "expo-constants": "~58.0.13",
    "expo-device": "~58.0.5",
    "expo-document-picker": "~58.0.4",
    "expo-font": "~58.0.9",
    "expo-haptics": "~58.0.7",
    "expo-image-picker": "~58.0.10",
    "expo-linking": "~58.0.14",
    "expo-notifications": "~58.1.6",
    "expo-router": "~58.0.25",
    "expo-status-bar": "~58.0.4",
    "expo-web-browser": "~58.0.6",
    "heroui-native": "^1.0.10",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.0",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-health": "^1.19.0",
    "react-native-health-connect": "^4.1.3",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.0",
    "react-native-svg": "15.16.0",
    "react-native-url-polyfill": "^2.0.0",
    "react-native-web": "~0.21.4",
    "react-native-webview": "14.0.1",
    "react-native-worklets": "0.13.0",
    "tailwind-merge": "^3.4.0",
    "tailwind-variants": "^3.2.2",
    "tailwindcss": "^4.3.3",
    "uniwind": "^1.13.0",
    "whatwg-fetch": "^3.6.20"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "~19.3.0",
    "@types/react-test-renderer": "^19.3.0",
    "react-test-renderer": "19.3.0",
    "typescript": "^6.0.3",
    "vitest": "^3.2.4"
  },
  "expo": {
    "doctor": {
      "reactNativeDirectoryCheck": {
        "exclude": [
