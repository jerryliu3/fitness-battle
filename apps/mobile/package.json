{
  "name": "@fitness-battle/mobile",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "dev": "expo start --clear",
    "web": "expo start --web --clear",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "typecheck": "tsc --noEmit",
    "lint": "echo 'no lint configured'",
    "test": "echo 'no mobile unit tests yet'",
    "eas:build:ios": "eas build --platform ios --profile production",
    "eas:build:android": "eas build --platform android --profile production",
    "eas:submit:ios": "eas submit --platform ios --profile production --latest",
    "eas:submit:android": "eas submit --platform android --profile production --latest"
  },
