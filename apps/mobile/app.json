{
  "expo": {
    "name": "Overtaek",
    "slug": "overtaek",
    "scheme": "overtaek",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#40234e"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "react-native-health",
        {
          "isClinicalDataEnabled": false,
          "healthSharePermission": "Overtaek reads workouts so your week can be scored.",
          "healthUpdatePermission": "Overtaek does not write health data."
        }
      ],
      "react-native-health-connect"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.overtaek.app",
      "buildNumber": "1",
      "usesAppleSignIn": false,
      "infoPlist": {
        "CFBundleDisplayName": "Overtaek",
        "NSHealthShareUsageDescription": "Overtaek reads workouts so your week can be scored.",
        "NSHealthUpdateUsageDescription": "Overtaek does not write health data.",
        "ITSAppUsesNonExemptEncryption": false,
        "CFBundleURLTypes": [
          {
            "CFBundleURLSchemes": ["overtaek"]
          }
        ]
      },
      "privacyManifests": {
        "NSPrivacyAccessedAPITypes": [
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryUserDefaults",
            "NSPrivacyAccessedAPITypeReasons": ["CA92.1"]
          }
        ],
        "NSPrivacyTracking": false
      }
    },
    "android": {
      "package": "com.overtaek.app",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#40234e"
      },
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": false,
          "data": [
            {
              "scheme": "overtaek"
            }
          ],
          "category": ["BROWSABLE", "DEFAULT"]
        }
      ],
      "permissions": [
        "android.permission.INTERNET",
        "android.permission.health.READ_EXERCISE",
        "android.permission.health.READ_HEART_RATE",
        "android.permission.health.READ_SLEEP"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "eas": {
        "projectId": "bea1932b-6a00-4edc-9710-22350423c446"
      },
      "privacyPolicyUrl": "https://fitness-battle-one.vercel.app/privacy",
      "termsOfServiceUrl": "https://fitness-battle-one.vercel.app/terms",
      "supportEmail": "jerrry333x@gmail.com"
    }
  }
}
